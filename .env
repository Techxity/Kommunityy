# Base URL of the deployed app — only needed by the standalone cron scripts
# (scripts/*.mjs), which run outside any HTTP request so they have no origin
# to infer a link from. Used to build the "Choose a plan" button in trial
# reminder/ended emails. Update this once you're deployed on Railway; until
# then it points at local dev so links in test emails still work.
APP_URL="http://localhost:8080"

# WhatsApp Cloud API — optional. Powers WhatsApp birthday messages alongside
# email (see src/lib/whatsapp.ts for the one-time Meta Business setup and
# the exact template text to get approved). Leave unset and the app/cron
# script silently skip WhatsApp, email-only behavior is unchanged.
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATE_NAME="birthday_wish"
# WHATSAPP_TEMPLATE_LANG="en"